{
  "name": "@ngbastion/core",
  "version": "0.2.0",
  "description": "NgBastion type-aware data-flow security engine.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkolos1/ng-bastion.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/hkolos1/ng-bastion#readme",
  "bugs": {
    "url": "https://github.com/hkolos1/ng-bastion/issues"
  },
  "keywords": [
    "angular",
    "security",
    "sast",
    "static-analysis",
    "ngbastion"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^22.22.3 || >=24.15.0 <25"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "cp ../../LICENSE ."
  },
  "dependencies": {
    "@ngbastion/plugin-api": "workspace:*",
    "@ngbastion/config": "workspace:*",
    "@angular/compiler": "~22.3.0",
    "picomatch": "^4.0.7",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
