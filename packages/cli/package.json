{
  "name": "ngbastion",
  "version": "0.1.2",
  "description": "NgBastion \u2014 Angular-aware, local-first security scanner CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hkolos1/ng-bastion.git"
  },
  "homepage": "https://github.com/hkolos1/ng-bastion#readme",
  "bugs": {
    "url": "https://github.com/hkolos1/ng-bastion/issues"
  },
  "keywords": [
    "angular",
    "security",
    "sast",
    "static-analysis",
    "ngbastion"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./schema/report-v1.json": "./schema/report-v1.json",
    "./schema/baseline-v1.json": "./schema/baseline-v1.json"
  },
  "files": [
    "dist",
    "report-assets",
    "schema"
  ],
  "engines": {
    "node": "^22.22.3 || >=24.15.0 <25"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@ngbastion/config": "workspace:*",
    "@ngbastion/core": "workspace:*",
    "@ngbastion/plugin-api": "workspace:*",
    "@ngbastion/rules": "workspace:*",
    "ajv": "^8.20.0"
  },
  "bin": {
    "ngbastion": "./dist/bin.js"
  },
  "publishConfig": {
    "access": "public"
  }
}
