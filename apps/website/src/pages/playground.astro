---
import Layout from '../components/Layout.astro';
import data from '../generated/playground.json';

const description = 'A minimal NgBastion demonstration: three Angular examples with unsafe and safe variants, and the findings NgBastion produced for them at build time.';
const first = (text: string) => /^(.+?[.!?])(\s|$)/.exec(text)?.[1] ?? text;
---
<Layout title="Playground | NgBastion" description={description} path="/playground/">
  <section class="pg">
    <h1>Playground</h1>
    <p class="notice" role="note"><strong>Demonstration:</strong> results were produced by NgBastion at build time for these fixtures; this page does not scan arbitrary input.</p>

    <div class="controls">
      <fieldset>
        <legend>Example</legend>
        {data.examples.map((ex, i) => (
          <label><input type="radio" name="example" value={ex.id} checked={i === 0} /> {ex.title}</label>
        ))}
      </fieldset>
      <fieldset>
        <legend>Variant</legend>
        <label><input type="radio" name="variant" value="unsafe" checked /> Unsafe</label>
        <label><input type="radio" name="variant" value="safe" /> Safe</label>
      </fieldset>
    </div>

    {data.examples.map((ex) => (['unsafe', 'safe'] as const).map((variant) => {
      const v = ex.variants[variant];
      return (
        <article class="panel" data-example={ex.id} data-variant={variant} hidden={!(ex === data.examples[0] && variant === 'unsafe')} aria-live="polite">
          <h2>{ex.title}: {variant} variant</h2>
          <p class="blurb">{variant === 'unsafe' ? ex.blurb : 'The same feature written with the safer pattern.'}</p>
          <div class="cols">
            <div>
              {v.files.map((f) => (
                <figure class="code">
                  <figcaption>{f.name}</figcaption>
                  <pre><code>{f.code.split('\n').map((line, n) => {
                    const hit = v.findings.some((x) => x.location.line === n + 1 || x.trace?.some((s) => s.line === n + 1 && s.file.endsWith(f.name)));
                    return <span class={hit ? 'ln hit' : 'ln'}><span class="no" aria-hidden="true">{n + 1}</span>{line}{'\n'}</span>;
                  })}</code></pre>
                </figure>
              ))}
            </div>
            <div class="results">
              <h3>{v.findings.length === 0 ? 'No findings' : `${v.findings.length} finding${v.findings.length > 1 ? 's' : ''}`}</h3>
              {v.findings.length === 0 && (
                <p class="muted">NgBastion found none of the patterns it models in this variant. That is evidence about these rules only, not proof that the code is secure.</p>
              )}
              {v.findings.map((f) => {
                const rule = (data.rules as Record<string, { name: string; rationale: string; remediation: string }>)[f.ruleId]!;
                return (
                  <div class="finding">
                    <p class="head"><span class={`sev sev-${f.severity}`}>{f.severity}</span> <a href={`/rules/${f.ruleId.toLowerCase()}/`}>{f.ruleId}</a> {f.ruleName}</p>
                    <p class="meta">Confidence {f.confidence}, {f.evidenceKind} evidence, line {f.location.line}</p>
                    <p>{f.message}</p>
                    {f.trace && (
                      <ol class="trace">
                        {f.trace.map((s) => <li class={`k-${s.kind}`}><span class="k">{s.kind}</span> line {s.line}: {s.description}</li>)}
                      </ol>
                    )}
                    <details>
                      <summary>Why it matters and how to fix it</summary>
                      <p>{first(rule.rationale)}</p>
                      <p><strong>Fix:</strong> {rule.remediation}</p>
                    </details>
                  </div>
                );
              })}
            </div>
          </div>
        </article>
      );
    }))}
  </section>
</Layout>

<script>
  const panels = document.querySelectorAll<HTMLElement>('.panel');
  const pick = (name: string) => (document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)!).value;
  const update = () => {
    const ex = pick('example');
    const variant = pick('variant');
    panels.forEach((p) => { p.hidden = !(p.dataset.example === ex && p.dataset.variant === variant); });
  };
  document.querySelectorAll('input[type="radio"]').forEach((r) => r.addEventListener('change', update));
</script>

<style>
  .pg { padding-top: 2.5rem; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.2rem); margin: 0 0 1rem; letter-spacing: -0.03em; }
  .notice { border-left: 3px solid var(--amber); padding: 0.6rem 1rem; background: var(--surface); max-width: none; }
  .controls { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 1.75rem 0; }
  fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 0.6rem 1rem 0.8rem; display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; }
  legend { color: var(--muted); font-size: 0.9rem; padding: 0 0.3rem; }
  label { cursor: pointer; }
  input[type='radio'] { accent-color: var(--steel); }
  .panel h2 { font-size: 1.4rem; }
  .blurb, .muted, .meta { color: var(--muted); }
  .cols { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
  .code { margin: 0 0 1rem; }
  .code figcaption { font: 0.8rem var(--mono); color: var(--muted); margin-bottom: 0.35rem; }
  .code pre { background: var(--term); color: var(--term-text); border: 1px solid #2c3450; border-radius: 8px; padding: 0.8rem 0; overflow-x: auto; font-size: 0.8rem; line-height: 1.55; margin: 0; }
  .ln { display: block; padding: 0 1rem 0 0; }
  .ln.hit { background: rgba(233, 162, 59, 0.13); box-shadow: inset 3px 0 0 #e9a23b; }
  .no { display: inline-block; width: 3.2ch; margin-right: 1.2ch; text-align: right; color: #5d6681; user-select: none; }
  .finding { border-top: 1px solid var(--line); padding: 1rem 0; }
  .finding p { margin: 0 0 0.5rem; }
  .head { font-weight: 600; }
  .results .sev { text-transform: capitalize; }
  .results .trace { font: 0.8rem/1.55 var(--mono); }
  .results .trace li { white-space: normal; }
  .results .trace li:not(.k-source):not(.k-sink)::before { background: var(--bg); }
  .results .trace .k { color: var(--muted); }
  details summary { cursor: pointer; color: var(--steel); }
  details p { margin-top: 0.5rem; }
  .sev-critical { color: var(--sev-critical); } .sev-high { color: var(--sev-high); } .sev-medium { color: var(--sev-medium); } .sev-low { color: var(--sev-low); }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } }
</style>
